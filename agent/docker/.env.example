#
# Copiare in `.env` e riempire. Il file `.env` NON va messo sotto controllo di
# versione: per un'ora contiene un token valido.

# L'indirizzo della sonda, come lo si apre dal browser di questa macchina.
SNAP_AGENT_SONDA=https://10.0.0.5:5510

# Il token emesso dalla console della sonda, pagina Agenti.
# VALE UN'ORA E UNA VOLTA SOLA: dopo il primo avvio si puo' togliere da qui, perche'
# e' gia' stato speso e l'agente ha la propria chiave.
SNAP_AGENT_TOKEN=

# 0 se la sonda ha un certificato proprio, non firmato da un'autorita' pubblica.
# Va dichiarato, non subito: con 1 un certificato non valido ferma l'agente, ed e'
# il comportamento giusto.
SNAP_AGENT_VERIFICA_TLS=1

# Che cosa inviare. Vuoto = tutti i gruppi.
#   tutti        tutto quello che l'agente sa raccogliere
#   consigliato  tutto tranne l'inventario del software e le attivita' pianificate
#   minimo       solo identita', carico, dischi e rete: nulla che riguardi le persone
# Oppure un elenco: identita,carico,dischi,rete,sicurezza
SNAP_AGENT_GRUPPI=

# La versione dell'immagine costruita localmente.
SNAP_AGENT_VERSIONE=1.2.6
