# -----------------------------------------------------------------
# La sonda ascolta solo sul proprio loopback, porta 5511, IN CHIARO -- non
# raggiungibile dalla rete: tutto il traffico passa da qui, in HTTPS.
#
# DOVE STA LA SONDA lo dice una VARIABILE, `${SONDA_HOST}`, e va spiegato perche'
# non e' un numero scritto qui e perche' non e' una voce in /etc/hosts.
#
# La sonda puo' stare in due posti:
#
#   * in contenitore (esercizio su Linux, e prova su Docker Desktop): condivide la
#     rete con questo proxy, quindi e' sul loopback -> 127.0.0.1;
#   * SULLA MACCHINA, fuori dal contenitore (variante nativa su Windows, dove un
#     contenitore non vedrebbe la LAN): il loopback di questo proxy non e' quello
#     della macchina -> il gateway dell'host (host.docker.internal).
#
# PRIMA si usava `extra_hosts` nel compose, ed era SBAGLIATO: Docker rifiuta
# `extra_hosts` insieme a `network_mode: service:` -- proprio la variante per Docker
# Desktop, dove il proxy condivide la rete della sonda. L'errore e' netto e arriva
# solo all'avvio del contenitore, non da `docker compose config`:
#
#     Error response from daemon: conflicting options:
#     custom host-to-IP mapping and the network mode
#
# Con una variabile il problema non esiste: l'immagine di nginx sostituisce i
# `${...}` dei modelli in /etc/nginx/templates all'avvio (envsubst), ed e' lo stesso
# meccanismo che gia' usa il proxy del server. Cosi' la configurazione resta UNA SOLA
# per tutte le varianti -- nessuna deriva fra prova, esercizio e sonda nativa.
#
# `NGINX_ENVSUBST_FILTER=^SONDA_` nel compose limita la sostituzione alle sole
# variabili SONDA_*: senza quel filtro, una variabile d'ambiente che si chiamasse
# come una variabile di nginx la cancellerebbe.

server {
    listen 5512;
    server_name _;
    return 308 https://$host:5510$request_uri;
}

server {
    listen 5510 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/probe.crt;
    ssl_certificate_key /etc/nginx/certs/probe.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    # CHI ARRIVA IN CHIARO SULLA PORTA HTTPS VIENE RIMANDATO, non respinto.
    #
    # Il caso e' banale e capita a tutti: si digita `10.20.10.42:5510` nel browser,
    # che davanti a una porta non standard assume `http://`. nginx riceve una
    # richiesta in chiaro su una porta TLS e risponde
    #
    #     400 Bad Request
    #     The plain HTTP request was sent to HTTPS port
    #
    # che e' esatto e inutile: chi legge non sa di avere sbagliato schema, e conclude
    # che la sonda non risponde. Il 497 e' il codice interno con cui nginx segna
    # proprio questa condizione, e intercettarlo permette di rimandare all'indirizzo
    # giusto -- lo stesso servizio che gia' fa la 5512.
    #
    # `$host` e non un indirizzo fisso: la sonda si raggiunge dall'IP, da un nome, o
    # dal loopback, e rimandare sempre allo stesso indirizzo manderebbe altrove chi
    # arriva da una via diversa.
    error_page 497 =308 https://$host:5510$request_uri;

    # Il pacchetto di registrazione si incolla in un campo: non serve altro spazio.
    client_max_body_size 4m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # PRIMA IMPOSTAZIONE DELLA PASSWORD: seconda barriera, indipendente
    # dall'applicazione.
    #
    # La sonda concede questa pagina solo a chi arriva dall'indirizzo locale, e per
    # deciderlo guarda l'indirizzo del client -- che dietro un proxy arriva da
    # un'intestazione. Il codice della sonda dichiara di NON volersi fidare di
    # un'intestazione per una decisione di sicurezza, e ha ragione. Qui la decisione
    # la prende nginx sul VERO interlocutore TCP (`$remote_addr` a livello di
    # connessione, non un'intestazione): non e' falsificabile dal client. Cosi' la
    # proprieta' "la sonda appartiene a chi l'ha installata" resta valida anche se
    # domani qualcuno cambiasse la configurazione delle intestazioni.
    # Gli indirizzi ammessi stanno in un file a parte (montato dal compose): si
    # allarga la barriera senza duplicare questa configurazione, e il file dice da
    # solo chi puo' impossessarsi della sonda. Vedi allow-primo-accesso.conf.
    location = /primo-accesso {
        include /etc/nginx/allow-primo-accesso.conf;
        deny all;

        proxy_pass http://${SONDA_HOST}:5511;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  5510;
        proxy_set_header X-Real-IP         $remote_addr;
    }

    location / {
        # `${SONDA_HOST}` lo fissa il compose: loopback se la sonda e' in
        # contenitore, gateway dell'host se gira sulla macchina. Vedi la nota in
        # testa al file.
        proxy_pass http://${SONDA_HOST}:5511;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        # QUI IL PUNTO DELICATO. La sonda concede la PRIMA impostazione della password
        # solo a chi si collega dall'indirizzo locale (auth.py): e' cio' che impedisce
        # al primo che trova la sonda in rete di impossessarsene. Quel controllo legge
        # l'indirizzo del client, che dietro un proxy arriva da questa intestazione.
        # Percio' si SCRIVE con $remote_addr e non si accoda con
        # $proxy_add_x_forwarded_for: accodando, un client potrebbe inviare
        # "X-Forwarded-For: 127.0.0.1" e ottenere il privilegio dell'accesso locale.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  5510;
        proxy_set_header X-Real-IP         $remote_addr;

        proxy_connect_timeout 15s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
        proxy_buffering       off;
    }
}
