# -----------------------------------------------------------------
# .env.example — configurazione della SONDA snap in esercizio
# Copyright (c) 2024-26 DS Consulting — Licenza: MIT
# -----------------------------------------------------------------
# Copiare in `.env` e compilare. Il file `.env` NON va committato: contiene segreti.
#
#   cp .env.example .env

# --- Versione dell'immagine ---------------------------------------------------
SNAP_VERSION=1.2.9

# --- Chiave di sessione (OBBLIGATORIA) ---------------------------------------
# Firma il cookie di sessione dell'interfaccia della sonda. Se cambia, si rientra
# con la password (la registrazione al server NON si perde: sta nell'archivio).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SNAP_PROBE_SECRET_KEY=

# --- Certificato TLS ----------------------------------------------------------
# Si monta come file, non entra nell'immagine:
#   ./certs/probe.crt   catena completa
#   ./certs/probe.key   chiave privata (permessi 600)
#
# Autofirmato per una prova interna (in esercizio: certificato della propria CA):
#   mkdir -p certs && openssl req -x509 -newkey rsa:4096 -sha256 -days 730 -nodes \
#     -keyout certs/probe.key -out certs/probe.crt \
#     -subj "/CN=sonda.example.local" \
#     -addext "subjectAltName=DNS:sonda.example.local,IP:127.0.0.1,IP:10.20.10.42"
#
# Elencare nel SAN anche l'IP con cui si aprira' l'interfaccia: un certificato
# valido solo per 127.0.0.1 fa avvisare il browser quando si punta l'IP.

# --- Base dati PostgreSQL della sonda (OBBLIGATORIE) -------------------------
# Due utenze distinte, per principio del minimo privilegio:
#   PROBE_POSTGRES_*   il PROPRIETARIO: crea e migra lo schema
#   PROBE_PG_APP_*     l'utente dell'APPLICAZIONE: solo leggere e scrivere i dati
# Non usare la stessa password per entrambi: sono due livelli di accesso diversi.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ATTENZIONE: oggi la sonda scrive su SQLite (nel volume `probe-data`) e questa base
# dati NON viene ancora usata dal codice: e' il bersaglio del porting. Le credenziali
# servono comunque, perche' il contenitore non parte senza.
#
# La base dati ascolta su 127.0.0.1:5532 -- solo dalla macchina della sonda, e nel
# range di porte del progetto (vedi PORTS.md).
PROBE_POSTGRES_DB=snap_probe
PROBE_POSTGRES_USER=snap_probe_owner
PROBE_POSTGRES_PASSWORD=
PROBE_PG_APP_USER=snap_probe_app
PROBE_PG_APP_PASSWORD=

# --- Di quale certificato fidarsi per il server ------------------------------
# Serve quando il server ha un certificato PROPRIO (CA interna o autofirmato): non
# essendo firmato da una CA pubblica, la sonda rifiuta di parlargli e la
# registrazione si fermerebbe con "CERTIFICATE_VERIFY_FAILED".
#
# Mettere il file PEM in ./trust (montata in /etc/snap/trust) e indicarlo qui:
#   SNAP_PROBE_SERVER_CA=/etc/snap/trust/server-ca.crt
#
# Il file e' il certificato della CA interna, oppure -- se autofirmato -- il
# certificato del server stesso (mai la chiave privata). Vedi ./trust/LEGGIMI.md.
#
# Non esiste un interruttore per disattivare la verifica: su quel canale passano le
# chiavi della registrazione e l'inventario della rete.
SNAP_PROBE_SERVER_CA=

# --- Chi puo' scegliere la PRIMA password ------------------------------------
# Vuoto: la prima password si sceglie solo dalla postazione della sonda (127.0.0.1).
# Finche' la password non esiste, chi apre quella pagina diventa proprietario della
# sonda: per questo il permesso si concede, non si eredita.
#
# Per configurare la sonda puntando l'IP della macchina, elencare qui la PROPRIA
# postazione (indirizzi o reti, separati da virgola) -- non una rete intera:
#   SNAP_PROBE_FIRST_ACCESS_FROM=10.20.10.7
#
# La stessa apertura va fatta nel proxy, in allow-primo-accesso.conf: sono due
# barriere indipendenti, per scelta.
SNAP_PROBE_FIRST_ACCESS_FROM=

# --- Porte (rete host) --------------------------------------------------------
# Con `network_mode: host` le porte NON si rimappano: sono quelle scritte in
# nginx.conf e nel Dockerfile.
#   5510  interfaccia della sonda in HTTPS
#   5512  solo rimando da http a https
#   5511  la sonda, in chiaro ma SOLO su 127.0.0.1 (non raggiungibile dalla rete)
#
# NOTA: la registrazione al server avviene verso l'indirizzo pubblico configurato
# nella console (Impostazioni Sistema > Indirizzo pubblico del server). Se il server
# e' passato a HTTPS, quell'indirizzo deve iniziare per https:// e il certificato del
# server deve essere verificabile dalla sonda.
