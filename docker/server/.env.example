# -----------------------------------------------------------------
# .env.example — configurazione del SERVER snap in esercizio
# Copyright (c) 2024-26 DS Consulting — Licenza: MIT
# -----------------------------------------------------------------
# Copiare in `.env` e compilare. Il file `.env` NON va committato (e' in .gitignore
# e in .dockerignore): contiene segreti.
#
#   cp .env.example .env
#
# I valori con `:?` nel compose sono OBBLIGATORI: senza, il compose si rifiuta di
# partire invece di avviare un servizio con un segreto vuoto o predefinito.

# --- Versione dell'immagine ---------------------------------------------------
# Etichetta dell'immagine costruita. Si allinea alla versione dell'applicazione.
SNAP_VERSION=1.2.8

# --- Chiave di sessione (OBBLIGATORIA) ---------------------------------------
# Firma i cookie di sessione. Se cambia, tutti gli accessi decadono: si genera UNA
# volta e si conserva. Va tenuta come una password.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SNAP_SERVER_SECRET_KEY=

# --- PostgreSQL ---------------------------------------------------------------
# Il proprietario crea e migra lo schema; l'applicazione si collega con l'utente
# applicativo, che puo' solo leggere e scrivere i dati (nessun CREATE, nessun DROP).
# Due password DIVERSE: se coincidessero, il minimo privilegio sarebbe apparente.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=snap
POSTGRES_USER=snap_owner
POSTGRES_PASSWORD=
SNAP_PG_APP_USER=snap_app
SNAP_PG_APP_PASSWORD=

# --- Porte pubblicate sull'host ----------------------------------------------
# La console in HTTPS (range assegnato al progetto: 5500-5600).
SNAP_HTTPS_PORT=5500
# Solo per rimandare da http a https: chi digita http:// non trova un errore.
SNAP_HTTP_REDIRECT_PORT=5501
# Syslog degli apparati verso il SIEM. 514 e' la porta standard: viene mappata sulla
# 5514 interna, perche' l'applicazione gira non-root e non puo' legare la 514.
# Se la 514 dell'host e' occupata (un syslog di sistema), mettere 5514 e configurare
# gli apparati su quella.
SNAP_SYSLOG_PORT=514

# --- SIEM ---------------------------------------------------------------------
# Ascolto syslog integrato. Metterlo a 0 se si usa il container Vector (docker/siem).
SNAP_SERVER_SIEM_LISTENER=1

# --- Certificato TLS ----------------------------------------------------------
# NON e' una variabile: il certificato si monta come file, non entra nell'immagine.
#   ./certs/server.crt   catena completa (certificato + intermedi)
#   ./certs/server.key   chiave privata (permessi 600)
#
# Per una prova interna si puo' generare un autofirmato (in esercizio va usato un
# certificato emesso dalla propria CA, altrimenti i browser avvisano a ogni accesso):
#   mkdir -p certs && openssl req -x509 -newkey rsa:4096 -sha256 -days 730 -nodes \
#     -keyout certs/server.key -out certs/server.crt \
#     -subj "/CN=snap.example.local" \
#     -addext "subjectAltName=DNS:snap.example.local,IP:10.20.10.42"
