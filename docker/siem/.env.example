# snap SIEM - collettore Vector. Copia in .env e compila. NON committare .env.
# Il token si ottiene nella console: SIEM > Sorgenti log > crea un collettore.
SNAP_COLLECTOR_TOKEN=incolla-qui-il-token-del-collettore
# Indirizzo dell'endpoint di ingestione del server snap.
SNAP_INGEST_URI=http://host.docker.internal:5500/api/siem/ingest
